# Copia este archivo como ".env" y cambia los valores antes de correr el sistema # Puerto del servidor PORT=3000 # Secreto para firmar las cookies de sesion (usa una cadena larga y aleatoria) # Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" SESSION_SECRET=cambia_este_valor_por_algo_largo_y_aleatorio # Entorno: development | production NODE_ENV=development # Password inicial del administrador general (solo se usa la PRIMERA vez que se crea la base de datos) ADMIN_CLAVE=AdminGral ADMIN_PASSWORD_INICIAL=Temporal1
